{
    "manifest_version": 3,
    "name": "DataLite Portal",
    "version": "1.0.0",
    "description": "Toggle Lite Mode to optimize browsing experience.",
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "declarativeNetRequest",
        "declarativeNetRequestFeedback",
        "webRequest",
        "webNavigation"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "lite_mode_blocking",
                "enabled": false,
                "path": "rules.json"
            }
        ]
    },
    "action": {
        "default_popup": "popup/popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "purifier.js",
                "content.js",
                "metrics.js"
            ],
            "css": [
                "purifier.css"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "loader.js"
            ],
            "css": [
                "loader.css"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "middleware.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        }
    ],
    "web_accessible_resources": []
}